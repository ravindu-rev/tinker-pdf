<?xml version="1.0" encoding="utf-8"?>
<!--
  A folder feed and nothing else.

  `clear` is not decoration: without it nuget.org stays in the source list, and
  a restore that failed to find the locally packed TinkerPdf would silently
  succeed against whatever a package of that name is on nuget.org. There is no
  TinkerPdf there today; there is nothing stopping one appearing, and a smoke
  test that proves somebody else's package works is worse than no smoke test.

  `dotnet pack -o target/nuget` fills the folder, which is what
  `cargo xtask release` and .github/workflows/release.yml both do.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../../../target/nuget" />
  </packageSources>
</configuration>
