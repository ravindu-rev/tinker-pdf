<?xml version="1.0" encoding="utf-8"?>
<!--
  TinkerPdf from a folder feed and from nowhere else.

  `clear` is not decoration: without it every source the machine configures
  stays in the list, and a restore that failed to find the locally packed
  TinkerPdf would silently succeed against whatever a package of that name is
  on nuget.org. There is no TinkerPdf there today; there is nothing stopping
  one appearing, and a smoke test that proves somebody else's package works is
  worse than no smoke test.

  `dotnet pack -o target/nuget` fills the folder, which is what
  `cargo xtask release` and .github/workflows/release.yml both do.

  nuget.org is listed for the SDK's own packs alone: the net8.0 targeting
  packs and app host, which an SDK restores as packages whenever the version
  it was built to ask for is not installed beside it, as on any SDK newer than
  the packs the machine has. The mapping is what keeps the first paragraph
  true: NuGet takes a package only from a source its ID is mapped to, so
  TinkerPdf comes from the folder or the restore fails, and nuget.org serves
  those three pack families and nothing else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../../../target/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="TinkerPdf" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETCore.App.*" />
      <package pattern="Microsoft.AspNetCore.App.*" />
      <package pattern="Microsoft.WindowsDesktop.App.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
