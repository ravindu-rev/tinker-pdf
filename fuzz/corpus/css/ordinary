@import url(base.css) screen;
body { margin: 0 5%; font-family: Georgia, "Times New Roman", serif; color: #222 }
h1, h2 { font-weight: bold; page-break-before: always; text-align: center }
p { text-indent: 1.2em; line-height: 1.5; orphans: 2; widows: 2 }
p.lead:first-child { font-variant: small-caps; letter-spacing: 0.05em }
blockquote { margin: 1em 2em; border-left: 3px solid #ccc; padding-left: 1em }
img { max-width: 100%; display: block }
.note { background: #f5f5f5; column-count: 2 }
a:link, a:visited { color: rgb(0, 0, 238); text-decoration: underline }
#top > div + p ~ span { float: left; clear: both; box-sizing: border-box }
@media screen and (min-width: 30em) { body { margin: 0 10% } }
@media print { body { color: black } }
